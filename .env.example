# Neon (or any PostgreSQL). If you see SSL issues on Windows, drop &channel_binding=require from the Neon URL.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxxx.region.aws.neon.tech/neondb?sslmode=require"
# Production (e.g. Vercel): add the same DATABASE_URL to the project env vars. `npm run build` runs
# `prisma migrate deploy` first so new columns (e.g. Project.published) exist before Next prerenders pages.
AUTH_SECRET="replace-with-long-random-string"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
ADMIN_EMAIL="admin@portfolio.local"
ADMIN_PASSWORD="changeme123"
# After deploy: set admin password without wiping the database (unlike db:seed):
#   ADMIN_EMAIL=admin@portfolio.local ADMIN_PASSWORD='your-secure-password' npm run db:set-admin
# Use production DATABASE_URL in env or .env.local when pointing at Neon/Vercel. Never commit real passwords.

# Optional: Admin → Projects → Import from GitHub (list repos + import README into new projects).
# Prefer a personal access token (classic: repo scope for private repos; public_repo for public only).
# Fine-grained tokens: read access to metadata + contents for the repos you need.
GITHUB_TOKEN=""
# If you omit GITHUB_TOKEN, set your GitHub username to list public repositories only (lower API rate limits).
GITHUB_USERNAME=""

# Contact form: each submission is saved in the database (Admin → Messages) AND emailed to you via Resend.
# Admin → Messages “Send email to visitor” uses the same RESEND_API_KEY / RESEND_FROM to reply without opening a mail app.
# Set CONTACT_NOTIFY_EMAIL so visitor replies (Reply in their client) route back to your inbox.
# Sign up at https://resend.com — create an API key, set CONTACT_NOTIFY_EMAIL to the inbox that should receive new submissions.
# For production, verify your domain in Resend and set RESEND_FROM e.g. "Portfolio <contact@yourdomain.com>".
# Testing: Resend allows onboarding@resend.dev only to your own account email until a domain is verified.
RESEND_API_KEY=""
CONTACT_NOTIFY_EMAIL=""
RESEND_FROM=""

# --- Vercel production (Project → Settings → Environment Variables) ---
# DATABASE_URL: Neon "pooled" / serverless connection string (Dashboard → Connect → pooled).
# AUTH_SECRET: e.g. openssl rand -base64 32 (must differ from local if you want isolation).
# NEXTAUTH_URL: https://madhushan.me (no trailing slash) — same host you set as primary in Vercel.
# NEXT_PUBLIC_APP_URL: same as NEXTAUTH_URL (canonical URL for metadata, sitemap.xml, robots.txt).
#
# Custom domains (replaces old Netlify setup in sandunMadhushan.github.io-oldd):
# - Add madhushan.me and sandun.is-a.dev under Vercel → Project → Settings → Domains; follow DNS instructions.
# - Old site used public/CNAME (sandun.is-a.dev) + Netlify UI for madhushan.me. Vercel does not use a CNAME file;
#   domains are configured in the dashboard only.
# - Short URLs (/github, /linkedin, project shortcuts, …) are defined in vercel.json (same idea as public/_redirects on Netlify).
# ADMIN_*: only needed when running `npm run db:seed` against that database (run once from your machine).
#
# Before or right after first deploy, apply the schema to production (from your PC, with prod DATABASE_URL):
#   npx prisma db push
#   npm run db:seed
#
# Admin image uploads: locally files go to public/uploads/. On Vercel, connect Blob and set:
# BLOB_READ_WRITE_TOKEN — Vercel dashboard → Storage → Blob → connect to this project (auto-adds env). Redeploy.
# Without it, use pasted image URLs only (e.g. Google Drive file share links; folder links are not supported).
