# Neon (or any PostgreSQL). If you see SSL issues on Windows, drop &channel_binding=require from the Neon URL.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxxx.region.aws.neon.tech/neondb?sslmode=require"
AUTH_SECRET="replace-with-long-random-string"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
ADMIN_EMAIL="admin@portfolio.local"
ADMIN_PASSWORD="changeme123"

# Optional: Admin → Projects → Import from GitHub (list repos + import README into new projects).
# Prefer a personal access token (classic: repo scope for private repos; public_repo for public only).
# Fine-grained tokens: read access to metadata + contents for the repos you need.
GITHUB_TOKEN=""
# If you omit GITHUB_TOKEN, set your GitHub username to list public repositories only (lower API rate limits).
GITHUB_USERNAME=""

# --- Vercel production (Project → Settings → Environment Variables) ---
# DATABASE_URL: Neon "pooled" / serverless connection string (Dashboard → Connect → pooled).
# AUTH_SECRET: e.g. openssl rand -base64 32 (must differ from local if you want isolation).
# NEXTAUTH_URL: https://your-project.vercel.app (no trailing slash). Update when you add a custom domain.
# NEXT_PUBLIC_APP_URL: same as NEXTAUTH_URL (used for absolute links / metadata).
# ADMIN_*: only needed when running `npm run db:seed` against that database (run once from your machine).
#
# Before or right after first deploy, apply the schema to production (from your PC, with prod DATABASE_URL):
#   npx prisma db push
#   npm run db:seed
#
# Note: files saved under public/uploads/ do not persist on Vercel (ephemeral filesystem). For production
# uploads, use Vercel Blob, S3, Cloudinary, or similar and point your upload API at that storage.
