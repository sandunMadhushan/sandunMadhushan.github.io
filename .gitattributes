# Normalize line endings on commit. The working tree keeps native endings;
# the repository always stores LF. Without this, files authored on Windows
# and files authored on Linux appear wholly-modified against each other.
* text=auto eol=lf

# Binary assets — never touch these.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.pdf binary
